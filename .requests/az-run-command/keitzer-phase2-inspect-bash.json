{
  "vm": "openclaw-vm",
  "rg": "SDNeurosurgery-OpenClaw",
  "script": "bash -lc 'set -euo pipefail; echo "=== health emily-claude ==="; bash /home/azureuser/bot-health-check.sh emily-claude; echo; echo "=== keitzer files ==="; ls -la /home/azureuser/.keitzer-bot /home/azureuser/keitzer-* /etc/systemd/system/keitzer-*.service 2>&1 || true; echo; echo "=== emily-claude units ==="; systemctl cat emily-claude-bot.service emily-claude-responder.service; echo; echo "=== emily-claude route ==="; grep -n "emily-claude/api/messages" /etc/nginx/sites-enabled/openclaw-sdneuro 2>&1 || true; echo; echo "=== listening ports ==="; ss -tlnp | grep -E "127\\.0\\.0\\.1:[0-9]+" | sort -u; echo; echo "=== bot scripts ==="; ls -1 /home/azureuser/*-{bot.py,responder.py,send-to.sh} 2>/dev/null | sed -n "1,120p"'"
